<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:kursadarbs_reactiveUI.ViewModels"
        xmlns:assets="using:kursadarbs_reactiveUI.Assets"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="kursadarbs_reactiveUI.AnnoyedApp"
        x:DataType="vm:AnnoyedAppViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{x:Static assets:Resources.MoodyMode2}"
        Width="800"
        Height="450"
        
        MinWidth="650"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        >
 <Border CornerRadius="10">
        <Grid Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Moody Pal"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="White"
                       FontSize="18"
                       Margin="0"/>
                <Border
                    Grid.Row="1"
                        Margin="10"
                        CornerRadius="8"
                        BorderThickness="1.5"
                        BorderBrush="#55FFFFFF"
                        Background="#22FFFFFF">
				<StackPanel Grid.Row="1" Name="RadioButtonPanel">
                
                <Button 
                             Click="Journal_Click"
                             Height="50" Foreground="White"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="16"
                             Margin="5">
				    <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Assets/diary.png"
                           x:Name="icon"
                           Height="40"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           IsVisible="true"/>

                    <TextBlock Grid.Column="1"
                         Text="{x:Static assets:Resources.AppTitleButton}"
                         x:Name="AppTitleButton"
                         IsVisible="False"
                         Foreground="White"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"/>
                    </Grid>
                
                    </Button>
                    <Button
                             Click="Focus_Click"
                             Height="50"
                             Margin="5"
                             Foreground="White"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="16">

                    <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Assets/chronometer.png"
                           x:Name="icon1"
                           Height="40"
                           IsVisible="true"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="1"
                         Text="{x:Static assets:Resources.AppTitleButton1}"
                         x:Name="AppTitleButton1"
                         Foreground="White"
                         IsVisible="False"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"/>
                    </Grid>

                    </Button>
                <Button
                             x:Name="todo_btn"
                             Click="Todo_Click"
                             Height="50"
                             Margin="5"
                             Foreground="White"
                             FontSize="16"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center">
                   <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Assets/check-list.png"
                           x:Name="icon2"
                           IsVisible="true"
                           Height="40"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="1"
                         Text="{x:Static assets:Resources.AppTitleButton2}"
                         x:Name="AppTitleButton2"
                         IsVisible="False"
                         Foreground="White"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"/>
                    </Grid>
                    </Button>
                 <Button
                    Height="50"
                    Margin="5"
                    Foreground="White"
                    x:Name="breathe_btn"
                    Click="breathe_btn_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="16">

                    <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Assets/breathe.png"
                           Height="40"
                           x:Name="icon3"
                           IsVisible="true"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="1"
                         Text="{x:Static assets:Resources.AppTitleButton3}"
                         x:Name="AppTitleButton3"
                         Foreground="White"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         IsVisible="False"/>
                    </Grid>
                    </Button>
                    <CheckBox Foreground="White" Margin="5,0,0,0" x:Name="Check_invis"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              FontSize="16"
                              Content="{x:Static assets:Resources.Icons}" IsChecked="true" Checked="Check_invis_Checked"
                              Unchecked="Check_invis_Unchecked">
                    </CheckBox>
            </StackPanel>
            </Border>
            <StackPanel 
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                        <Label
                           Content="{x:Static assets:Resources.LangSelect_title}"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Padding="5"/>
						    <Button x:Name="langselect_eng"
                                    Content="ENG"
                                    FontSize="16"
                                    Click="langselect_eng_Click"
                                    HorizontalAlignment="Right"
                                    Foreground="White"
                                    />
                            <Button x:Name="langselect_lv"
                                    Content="LV"
                                    FontSize="16"
                                    Click="langselect_lv_Click"
                                    HorizontalAlignment="Right"
                                    Foreground="White"
                                    />
                
                    </StackPanel>
            <Button x:Name="moodselect_btn"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="8"
                    Content="{x:Static assets:Resources.MoodButton}"
                    Click="moodselect_btn_Click"
                    FontSize="14"
                    Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="White"
                    />
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    CornerRadius="8"
                    BorderThickness="1.5"
                    BorderBrush="#55FFFFFF"
                    Background="#22FFFFFF">
			<ContentControl 
                Grid.Row="1"
                Grid.Column="1"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Content="{Binding CurrentPage}"
                Foreground="White"/>	
            </Border>
            
        </Grid>
    </Border>
    <Window.Background>
		<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%">
            <GradientStop Color="#041421" Offset="0"/>
            <GradientStop Color="#042630" Offset="0.5"/>
            <GradientStop Color="#4c7273" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
</Window>
